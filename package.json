{
  "name": "nowhere-mark",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.4.2",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:versions": "node scripts/check-versions.mjs",
    "check:deps": "npm ls --all",
    "check:outdated": "npm outdated || true",
    "check:audit": "npm audit --audit-level=high",
    "verify": "npm run check:versions && npm run typecheck && npm run lint && npm run test && npm run build",
    "predeploy": "npm run verify && npm run check:audit"
  },
  "dependencies": {
    "lucide-react": "^0.552.0",
    "next": "^16.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.22",
    "eslint": "^9.39.1",
    "eslint-config-next": "^16.0.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  }
}
